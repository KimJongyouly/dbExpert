# dbExpert 자격증명 파일 예시.
#
#   cp .env.example .env && chmod 600 .env
#
# config/connections.yaml의 user_env / password_env 에 적은 "환경변수 이름"에
# 대응하는 실제 값을 여기에 적는다. server/main.py가 기동 시 python-dotenv로
# 이 파일을 직접 읽으므로 쉘 프로파일(~/.zshrc 등)에 export할 필요가 없다.
# .env 는 .gitignore에 등록되어 있어 커밋되지 않는다. 이 예시 파일에는
# 절대 실제 값을 넣지 않는다.

# --- config/connections.example.yaml 의 Connection 이름과 맞춘 예시 ---
DBEXPERT_PROD_AURORA_USER=readonly_user
DBEXPERT_PROD_AURORA_PASSWORD=change-me
# DBEXPERT_PROD_AURORA_BASTION_KEY_PASSPHRASE=   # 암호화된 pem 키일 때만

DBEXPERT_DEV_POSTGRES_USER=readonly_user
DBEXPERT_DEV_POSTGRES_PASSWORD=change-me

# DBEXPERT_PROD_MSSQL_USER=
# DBEXPERT_PROD_MSSQL_PASSWORD=
# DBEXPERT_PROD_CLICKHOUSE_USER=
# DBEXPERT_PROD_CLICKHOUSE_PASSWORD=
# DBEXPERT_PROD_MONGO_USER=
# DBEXPERT_PROD_MONGO_PASSWORD=
# DBEXPERT_PROD_MONGO_BASTION_PASSWORD=          # ssh.login_mode: password 일 때
# DBEXPERT_PROD_SEARCH_USER=
# DBEXPERT_PROD_SEARCH_PASSWORD=
# DBEXPERT_PROD_CACHE_PASSWORD=                  # Redis는 AUTH 없으면 생략 가능

# --- Ontology/RAG 임베딩 모델 (선택, Doc/02_설치.md §4) ---
# HF_HOME=/path/to/large-disk/huggingface-cache  # HuggingFace 캐시 위치 변경
# DBEXPERT_EMBEDDING_MODEL=/abs/path/to/local-model  # 폐쇄망: 로컬 모델 디렉터리
# DBEXPERT_EMBEDDING_DIM=384                     # 기본 모델이 아닐 때만 함께 지정
# HF_HUB_OFFLINE=1                               # 폐쇄망에서 Hub 접근 자체를 막음
